{# templates/services.html.twig #}
<!-- Services Section -->
<section id="services" class="max-w-7xl mx-auto px-8 mb-section-gap reveal">
    <h2 class="font-headline-lg text-headline-lg text-white mb-12 flex items-center gap-4">
        <span class="w-12 h-1 bg-sky-500"></span> SERVICES
    </h2>
    <p class="font-body-lg text-body-lg text-slate-400 mb-12 max-w-2xl">
        Tous les services que je peux vous proposer pour concrétiser vos projets digitaux
    </p>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="glass-card p-8 rounded-xl hover:border-sky-500 transition-all group">
            <div class="w-16 h-16 bg-sky-500/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-sky-500/20 transition-all">
                <i class="bi bi-briefcase text-sky-400 text-3xl"></i>
            </div>
            <h3 class="font-headline-md text-headline-md text-white mb-4">Web Design</h3>
            <p class="font-body-md text-body-md text-slate-400">
                Création de designs modernes et intuitifs pour vos sites web et applications, basés sur vos spécifications.
            </p>
        </div>

        <div class="glass-card p-8 rounded-xl hover:border-sky-500 transition-all group">
            <div class="w-16 h-16 bg-sky-500/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-sky-500/20 transition-all">
                <i class="bi bi-card-checklist text-sky-400 text-3xl"></i>
            </div>
            <h3 class="font-headline-md text-headline-md text-white mb-4">Web Development</h3>
            <p class="font-body-md text-body-md text-slate-400">
                Développement complet, maintenance, ajout de fonctionnalités, debugging - ou tout à la fois selon vos besoins.
            </p>
        </div>

        <div class="glass-card p-8 rounded-xl hover:border-sky-500 transition-all group">
            <div class="w-16 h-16 bg-sky-500/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-sky-500/20 transition-all">
                <i class="bi bi-tools text-sky-400 text-3xl"></i>
            </div>
            <h3 class="font-headline-md text-headline-md text-white mb-4">Webmastering</h3>
            <p class="font-body-md text-body-md text-slate-400">
                Gestion et administration complète de sites web, maintenance technique et optimisation continue.
            </p>
        </div>
    </div>
</section><!-- End Services Section -->