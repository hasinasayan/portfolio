<!DOCTYPE html>
<html class="dark" lang="fr">

{% block header %}
    {% include 'header.html.twig' %}
{% endblock %}

{% block menu %}
    {% include 'menu.html.twig' %}
{% endblock %}

<main class="pt-32">
    <!-- Hero Section -->
    <section id="about" class="max-w-7xl mx-auto px-8 mb-section-gap flex flex-col md:flex-row items-center gap-12">
        <div class="flex-1 space-y-6">
            <div class="inline-block px-4 py-1 glass-card rounded-full text-sky-400 font-label-md text-label-md border-sky-500/30">
                9 ANS D'EXPERIENCE
            </div>
            <h1 class="font-headline-xl text-headline-xl text-white tracking-tighter uppercase leading-none">
                Hasina <br/> <span class="text-sky-500 text-glow animate-glow-pulse">Ravonimbola</span>
            </h1>
            <p class="font-body-lg text-body-lg text-slate-400 max-w-xl">
                Développeur Full-Stack spécialisé en Symfony, WordPress, Laravel et solutions web sur mesure, avec une forte expertise en performance, API et optimisation UX.
            </p>
            <div class="flex gap-4 pt-4">
                <a class="btn-cyber px-8 py-4 bg-primary-container text-white font-label-md text-label-md rounded-lg glow-border transition-all" href="#work">VOIR MES PROJETS</a>
                <a class="btn-cyber px-8 py-4 border border-white/10 glass-card text-white font-label-md text-label-md rounded-lg hover:bg-white/5 transition-all" href="#contact">ME CONTACTER</a>
            </div>
        </div>
        <div class="relative w-full max-w-md aspect-[3/4]">
            <div class="absolute inset-0 bg-sky-500/20 blur-[100px] rounded-full"></div>
            <div class="relative w-full h-full glass-card rounded-2xl overflow-hidden border-sky-500/20 p-2">
                <picture>
                    <source srcset="{{ asset('assets/img/Portrait_Team_Hasina.jpg') }}" type="image/jpeg">
                    <img src="{{ asset('assets/img/Portrait_Team_Hasina.jpg') }}" alt="Hasina Ravonimbola Profile" class="w-full h-full object-cover rounded-xl" title="Hasina Ravonimbola - Full-Stack Developer">
                </picture>
            </div>
        </div>
    </section>

    <!-- ======= Skills Section ======= -->
    {% block skills %}
        {% include 'skills.html.twig' %}
    {% endblock %}

    <!-- ======= Services Section ======= -->
    {% block services %}
        {% include 'services.html.twig' %}
    {% endblock %}

    <!-- ======= Portfolio Section ======= -->
    {% block portfolio %}
        {% include 'potfolio.html.twig' %}
    {% endblock %}

    <!-- ======= Contact Section ======= -->
    {% block contact %}
        {% include 'contact.html.twig' %}
    {% endblock %}

<!-- ======= Footer ======= -->
{% block footer %}
{% include 'footer.html.twig' %}
{% endblock %}